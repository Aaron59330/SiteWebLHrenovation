# Copiez ce fichier en ".env" et remplissez-le (chmod 600 .env). Ne le publiez jamais.
PORT=3000
NODE_ENV=production
# L'adresse publique du site (sert à vérifier l'origine des requêtes)
SITE_URL=https://votre-domaine.fr

# Secret pour signer les connexions : longue chaîne aléatoire
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Votre accès administrateur (page /admin.html)
ADMIN_EMAIL=lhrenovation.int@gmail.com
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long-et-unique

# E-mails (notification à chaque devis / avis). Exemple Gmail :
# activez la validation en 2 étapes puis créez un "mot de passe d'application"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lhrenovation.int@gmail.com
SMTP_PASS=
NOTIFY_TO=lhrenovation.int@gmail.com
